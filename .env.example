# Copiar a .env.local y llenar cuando exista un proyecto real. Ninguna de
# estas variables existe hoy — la app sigue funcionando 100% con localStorage
# mientras no estén configuradas (ver docs/12-guia-backend.md).

# Supabase (base de datos + autenticación real + storage de archivos)
# Se obtienen en supabase.com -> tu proyecto -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo si se necesitan operaciones de servidor con privilegios elevados
# (ej. purgar la papelera de recetas vencida desde una Edge Function).
# NUNCA exponer esta con el prefijo NEXT_PUBLIC_ — es de servidor únicamente.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (pagos reales de los planes de /planes) — ver lib/stripe/, y
# app/signup/payment/page.tsx (hoy simula el cobro, no envía nada a ningún
# lado). Claves en dashboard.stripe.com -> Developers -> API keys.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Se genera al crear el webhook endpoint en Stripe (Developers -> Webhooks),
# apuntando a https://tu-dominio.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# URL pública del sitio — usada para construir links de retorno de Stripe
# Checkout y de reseteo de contraseña de Supabase. En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Código de acceso a /admin (ver app/api/admin/verify/route.ts). SIN el prefijo
# NEXT_PUBLIC_ a propósito — nunca debe llegar al bundle del navegador. Si no se
# configura, se usa "gastro-admin-2026" como respaldo (cambiarlo antes de producción).
ADMIN_PASSCODE=

# Resend (notificación por correo cuando alguien escribe desde /contacto) — ver
# lib/services/notify-feedback.ts. Opcional: si no se configura, el formulario de
# contacto sigue funcionando normal (el mensaje se guarda igual, solo no llega
# el correo de aviso). API key en resend.com -> API Keys.
RESEND_API_KEY=
# A qué correo(s) llega el aviso — normalmente el correo del dueño del proyecto.
FEEDBACK_NOTIFY_TO=
# Remitente del correo de aviso. Con una cuenta de Resend sin dominio propio
# verificado, debe quedarse en "onboarding@resend.dev" (o el que Resend indique).
FEEDBACK_NOTIFY_FROM=
